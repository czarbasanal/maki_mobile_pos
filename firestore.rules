rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get the current user's document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if current user has a specific role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    // Check if current user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Check if current user is staff or admin
    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }
    
    // Check if current user is any valid role
    function isValidUser() {
      return hasRole('cashier') || hasRole('staff') || hasRole('admin');
    }
    
    // Check if user is active
    function isActiveUser() {
      return isAuthenticated() && getUserData().isActive == true;
    }

    // Shop timezone offset, in minutes east of UTC, from settings/general.
    // Falls back to +8h (Asia/Manila) when the doc or the field is absent —
    // that fallback is what keeps a pre-seed database and older app versions
    // behaving exactly as before.
    function shopOffsetMinutes() {
      return exists(/databases/$(database)/documents/settings/general)
        ? get(/databases/$(database)/documents/settings/general).data.get('tzOffsetMinutes', 480)
        : 480;
    }

    // The shop's business day as a yyyymmdd int, for drawer_state math.
    // Must match shopDayInt() on mobile and web for the same instant.
    function phDay() {
      let t = request.time + duration.value(shopOffsetMinutes(), 'm');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // settings/general is a shared bucket; only the timezone keys are
    // validated. A bad tzOffsetMinutes would break the business day on every
    // device, and the rules themselves read this value.
    function validGeneralSettings() {
      let d = request.resource.data;
      return (!d.keys().hasAny(['tzOffsetMinutes']) ||
              (d.tzOffsetMinutes is int &&
               d.tzOffsetMinutes >= -720 &&
               d.tzOffsetMinutes <= 840)) &&
             (!d.keys().hasAny(['timezoneId']) || d.timezoneId is string);
    }

    // True when no past sales-day is awaiting closing: the state doc is
    // missing (fresh DB / pre-rollout), today already has sales (day is
    // live), or the latest sales-day has been closed.
    function drawerSettled() {
      let data = get(/databases/$(database)/documents/drawer_state/state).data;
      return !exists(/databases/$(database)/documents/drawer_state/state) ||
        data.get('lastSaleDay', 0) == phDay() ||
        (data.get('lastClosedDay', 0) >= data.get('lastSaleDay', 0));
    }

    // ==================== USERS COLLECTION ====================
    
    match /users/{userId} {
      // Users can read their own document; admins can read all users.
      // Read is intentionally NOT gated on isActiveUser() so a deactivated
      // user can still discover their isActive=false state on login.
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      // Writes require an active session. Without isActiveUser() a
      // deactivated admin could still mint/delete accounts as long as their
      // auth session was valid (regression caught by the rules suite).
      allow create: if isAdmin() && isActiveUser();

      // Users can update their own non-role fields (displayName, password handled by Auth).
      // Admins can update any user.
      allow update: if isAuthenticated() && isActiveUser() && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])) ||
        isAdmin()
      );

      // Delete is deactivate-first and never self: only an active admin may
      // delete ANOTHER user's doc, and only after that user is deactivated.
      // The Auth credential is removed separately (scripts/delete-auth-user.mjs).
      allow delete: if isAdmin() && isActiveUser()
        && request.auth.uid != userId
        && resource.data.isActive == false;
    }

    // ==================== PRODUCTS COLLECTION ====================
    
    match /products/{productId} {
      // All valid users can read products (for POS and inventory view)
      allow read: if isValidUser() && isActiveUser();
      
      // Admin and staff can create products. Staff enter a cost CODE that the
      // app decodes to cost, so there is no field-level cost constraint here.
      // Cashier cannot create. Delete stays admin-only, and only for a
      // DEACTIVATED product — the web danger zone's deactivate-first gate,
      // enforced server-side so a client bug can't remove an active part.
      allow create: if (isAdmin() || hasRole('staff')) && isActiveUser();
      allow delete: if isAdmin() && isActiveUser() && resource.data.isActive == false;

      // Admin can update any product field
      allow update: if isAdmin() && isActiveUser();

      // Staff can update product fields EXCEPT sku, price, cost, costCode, and
      // sellingOptions (SKU edits are admin-only; selling options set prices,
      // so they carry the same lock as price). Unchanged values never appear
      // in affectedKeys(), so a staff edit that leaves them alone still passes.
      allow update: if hasRole('staff') && isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sku', 'price', 'cost', 'costCode', 'sellingOptions']);

      // Cashier can update name + imageUrl. Denylist is intentionally
      // limited to **non-nullable** fields (sku, costCode, cost, price,
      // quantity, isActive) so it doesn't trip on the client's
      // toUpdateMap(), which writes every product field — including
      // nullable ones as null. Older docs missing those nullable fields
      // would otherwise count their addition as a "change" and fail the
      // rule even when the cashier didn't touch them. Defense-in-depth
      // for less-critical fields (category, notes, supplier, etc.) is
      // enforced client-side by UpdateProductUseCase. sellingOptions is the
      // one exception added to the denylist despite being nullable-ish
      // (often absent) — it sets prices, so it's locked to admin the same
      // as price/cost/costCode; the client only writes it via
      // toUpdateMap(includeSellingOptions: true) on the admin edit path, so
      // it never appears in a cashier's diff unless deliberately smuggled in.
      allow update: if hasRole('cashier') && isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sku', 'costCode', 'cost', 'price', 'quantity', 'isActive', 'sellingOptions'
        ]);

      // Any valid user can update stock (quantity) during sale processing.
      // updatedByName is included because ProcessSaleUseCase records the
      // cashier's name on the stock write; without it, cashier sales would
      // complete but silently fail to deduct inventory.
      allow update: if isValidUser() && isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updatedAt', 'updatedBy', 'updatedByName']);
      
      // Price history subcollection
      match /price_history/{historyId} {
        allow read: if isAdmin() && isActiveUser();
        allow write: if isAdmin() && isActiveUser();
      }

      // Append-only stock-adjustment audit records (spec 2026-09-04).
      // Created atomically with the quantity write by adjustStockAudited.
      // NEVER updated or deleted — an erroneous adjustment is superseded
      // by another adjustment.
      match /stock_adjustments/{adjustmentId} {
        allow read: if isStaffOrAdmin() && isActiveUser();
        allow create: if isStaffOrAdmin() && isActiveUser() &&
          request.resource.data.mode in ['add', 'remove', 'set'] &&
          // "Set to" can erase a discrepancy without recording its size —
          // admin only. Add/Remove always carry the delta.
          (request.resource.data.mode != 'set' || isAdmin()) &&
          // A deactivated part is out of circulation; reactivate first.
          get(/databases/$(database)/documents/products/$(productId)).data.isActive == true &&
          request.resource.data.after == request.resource.data.before + request.resource.data.delta &&
          request.resource.data.after >= 0 &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    // The price-change report reads price_history via a collection-group query.
    // The nested products/*/price_history rule above governs writes and
    // per-product reads; this recursive-wildcard rule authorizes the group
    // query. Admin-only, matching the nested rule.
    match /{path=**}/price_history/{historyId} {
      allow read: if isAdmin() && isActiveUser();
    }

    // ==================== SUPPLIERS COLLECTION ====================
    
    match /suppliers/{supplierId} {
      // Staff need to READ suppliers: the Receiving flow's supplier picker
      // streams the list for anyone with receiving access (2026-07-24 fix —
      // read was admin-only since init, breaking staff bulk receiving).
      allow read: if isStaffOrAdmin() && isActiveUser();

      // Managing suppliers (add/edit/delete) stays admin-only, matching the
      // in-app viewSuppliers gating.
      allow write: if isAdmin() && isActiveUser();
    }
    
    // ==================== SALES COLLECTION ====================
    
    match /sales/{saleId} {
      // All valid users can read sales (for reports based on role)
      // App-level logic restricts cashier/staff to today's sales only
      allow read: if isValidUser() && isActiveUser();
      
      // All valid users can create sales (POS), gated on the drawer being
      // settled server-side (no past unclosed sales-day).
      allow create: if isValidUser() && isActiveUser() && drawerSettled();
      
      // Only admin can update sales (for voiding)
      // Staff and cashier CANNOT void sales
      allow update: if isAdmin() && isActiveUser();
      
      // No one can delete sales (audit trail)
      allow delete: if false;
      
      // Sale items subcollection
      match /items/{itemId} {
        allow read: if isValidUser() && isActiveUser();
        allow write: if isValidUser() && isActiveUser();
      }
    }
    
    // ==================== JOB ORDERS COLLECTION ====================

    match /job_orders/{jobOrderId} {
      // All valid active users can read job orders
      allow read: if isValidUser() && isActiveUser();

      // Users can create job orders
      allow create: if isValidUser() && isActiveUser() &&
        request.resource.data.createdBy == request.auth.uid;

      // Ticket edits stay creator-or-admin. One narrow exception: whoever
      // rings the ticket up at the register may mark it converted — bill-out
      // writes exactly the conversion fields — regardless of who created it.
      // Two invariants stay pinned server-side:
      // - createdBy is immutable, otherwise the creator-or-admin rules could
      //   be laundered by rewriting createdBy first;
      // - a converted (billed-out) ticket is frozen, so a stale editor can
      //   never flip isConverted back and let the ticket be billed twice.
      allow update: if isValidUser() && isActiveUser() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        resource.data.get('isConverted', false) == false &&
        (
          resource.data.createdBy == request.auth.uid || isAdmin() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['isConverted', 'convertedToSaleId', 'convertedAt', 'updatedAt']
          ) && request.resource.data.isConverted == true)
        );

      // Deleting a ticket stays creator-or-admin.
      allow delete: if isValidUser() && isActiveUser() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ==================== RECEIVINGS COLLECTION ====================

    match /receivings/{receivingId} {
      // Staff and admin can read receivings
      allow read: if isStaffOrAdmin() && isActiveUser();

      // Staff and admin can create/update receivings
      allow create, update: if isStaffOrAdmin() && isActiveUser();

      // Only admin can delete receivings
      allow delete: if isAdmin() && isActiveUser();
    }

    // ==================== PURCHASE ORDERS COLLECTION ====================

    match /purchase_orders/{purchaseOrderId} {
      // Staff and admin can read purchase orders
      allow read: if isStaffOrAdmin() && isActiveUser();

      // Staff and admin can create/update purchase orders
      allow create, update: if isStaffOrAdmin() && isActiveUser();

      // Only admin can delete purchase orders
      allow delete: if isAdmin() && isActiveUser();
    }

    // ==================== EXPENSES COLLECTION ====================
    
    match /expenses/{expenseId} {
      // All valid users can read expenses
      allow read: if isValidUser() && isActiveUser();
      
      // All valid users can create expenses (cashier/staff can add)
      allow create: if isValidUser() && isActiveUser();
      
      // All valid users can update/delete expenses (shop policy 2026-07-04:
      // cashier/staff fix and remove their own entry mistakes; the activity
      // log keeps the audit trail)
      allow update, delete: if isValidUser() && isActiveUser();
    }
    
    // ==================== DAILY CLOSINGS COLLECTION ====================

    match /daily_closings/{closingId} {
      // Any active valid user (cashier/staff/admin) can read closings.
      allow read: if isValidUser() && isActiveUser();

      // Active valid users can create a closing (cashier closes, admin too).
      allow create: if isValidUser() && isActiveUser();

      // Closings are immutable once saved (audit record).
      allow update, delete: if false;
    }

    // ==================== USER LOGS COLLECTION ====================
    
    match /user_logs/{logId} {
      // Only admin can read logs
      allow read: if isAdmin() && isActiveUser();
      
      // System can create logs (all authenticated users)
      allow create: if isAuthenticated();
      
      // No one can update or delete logs (audit trail)
      allow update, delete: if false;
    }
    
    // ==================== SETTINGS COLLECTION ====================

    match /settings/{settingId} {
      // All valid users can read settings
      allow read: if isValidUser() && isActiveUser();

      // Only admin can modify settings
      allow write: if isAdmin() && isActiveUser() &&
        (settingId != 'general' || validGeneralSettings());

      // Exception: sale_counters holds the daily sale-number sequence.
      // Generating a sale number at checkout increments it inside the
      // createSale transaction, so cashier/staff must be able to write this
      // one doc — otherwise non-admin checkouts fail with permission-denied.
      allow write: if settingId == 'sale_counters' &&
        isValidUser() && isActiveUser();
    }

    // ==================== DRAWER STATE (single doc) ====================
    // Denormalized latest-sale-day / latest-closed-day so the sales-create
    // rule can enforce "no new sales on an unsettled drawer" server-side.
    match /drawer_state/{docId} {
      allow read: if isValidUser() && isActiveUser();
      // lastSaleDay may only be stamped to the CURRENT PH day; lastClosedDay
      // may only be set to today or a past day. No delete.
      // Bare `request.resource.data.lastSaleDay` / `.lastClosedDay` throw
      // (== deny) if a non-merged write drops the field while still
      // touching the other one; read via .get(...) with a sentinel that can
      // never satisfy its check instead, so a dropped field is an explicit
      // deny rather than an evaluation-error deny (same outcome, no crash
      // risk if the compiler ever changes error handling).
      allow create, update: if isValidUser() && isActiveUser() &&
        (!request.resource.data.diff(resource == null ? {} : resource.data)
            .affectedKeys().hasAny(['lastSaleDay']) ||
          request.resource.data.get('lastSaleDay', -1) == phDay()) &&
        (!request.resource.data.diff(resource == null ? {} : resource.data)
            .affectedKeys().hasAny(['lastClosedDay']) ||
          request.resource.data.get('lastClosedDay', 99999999) <= phDay());
      allow delete: if false;
    }

    // ==================== PRODUCT CATEGORIES COLLECTION ====================

    match /product_categories/{categoryId} {
      // All valid users can read categories (product form, inventory filter)
      allow read: if isValidUser() && isActiveUser();

      // Product Categories (2026-07-25): staff/admin only — cashiers keep
      // other shared lists but not product categories.
      allow create: if isStaffOrAdmin() && isActiveUser();
      allow update: if isStaffOrAdmin() && isActiveUser();
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== CATEGORY CODES REGISTRY ====================

    match /category_codes/{code} {
      allow read: if isValidUser() && isActiveUser();
      // Created only alongside a product category (staff+admin, mirroring
      // product_categories create) — includes the '_counter' doc.
      allow create: if isStaffOrAdmin() && isActiveUser();
      // Registry docs: only nextSequence may change (product-create bumps).
      // '_counter': only next may change (category-create bumps).
      allow update: if isStaffOrAdmin() && isActiveUser() &&
        (code == '_counter'
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextSequence']));
      allow delete: if false;
    }

    // ==================== EXPENSE CATEGORIES COLLECTION ====================

    match /expense_categories/{categoryId} {
      // All valid users can read categories (expense form)
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants (2026-07-24): any active user may add or edit
      // entries; only staff/admin may flip isActive (deactivate/reactivate);
      // delete is staff/admin (2026-07-25).
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== UNITS COLLECTION ====================

    match /units/{unitId} {
      // All valid users can read units (product form, inventory display)
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants (2026-07-24): any active user may add or edit
      // entries; only staff/admin may flip isActive (deactivate/reactivate);
      // delete is staff/admin (2026-07-25).
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== VOID REASONS COLLECTION ====================

    match /void_reasons/{reasonId} {
      // All valid users can read void reasons (void-sale dialog dropdown)
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants (2026-07-24): any active user may add or edit
      // entries; only staff/admin may flip isActive (deactivate/reactivate);
      // delete is staff/admin (2026-07-25).
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== MECHANICS COLLECTION ====================

    match /mechanics/{mechanicId} {
      // All valid users can read mechanics — the cashier-facing mechanic
      // picker on service job orders/sales streams active mechanics, so read is
      // intentionally NOT admin-only (mirrors void_reasons / categories).
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants (2026-07-24): any active user may add or edit
      // entries; only staff/admin may flip isActive (deactivate/reactivate);
      // delete is staff/admin (2026-07-25).
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== SHOP FEES COLLECTION ====================

    match /shop_fees/{feeId} {
      // Cashier-facing fee picker streams active fees — all-user read.
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants (2026-07-24): any active user may add or edit
      // entries; only staff/admin may flip isActive (deactivate/reactivate);
      // delete is staff/admin (2026-07-25).
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== PRODUCT TAGS COLLECTION ====================

    match /product_tags/{tagId} {
      // All valid users can read tags (inventory chips, tag filter, pickers)
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants: any active user may add or edit entries (name,
      // color, description); only staff/admin may flip isActive
      // (deactivate/reactivate); delete is staff/admin. Same template as
      // units / void_reasons / mechanics.
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== ADJUSTMENT REASONS COLLECTION ====================

    match /adjustment_reasons/{reasonId} {
      // All valid users can read reasons (adjust dialogs on both surfaces)
      allow read: if isValidUser() && isActiveUser();

      // Shared-list grants: any active user may add or rename; only
      // staff/admin may flip isActive OR requiresNote (the note policy is
      // policy, not naming); delete is staff/admin.
      allow create: if isValidUser() && isActiveUser();
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive', 'requiresNote']));
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== HR COLLECTION ====================

    // HR — salary data: admin-only for BOTH read and write (stricter than
    // mechanics' all-user read). See docs/superpowers/specs/2026-07-22-hr-payroll-web-design.md.
    match /employees/{employeeId} {
      allow read, write: if isAdmin() && isActiveUser();
    }
    match /payslips/{payslipId} {
      allow read, create, delete: if isAdmin() && isActiveUser();
      allow update: if false; // payslips are frozen records
    }

    // ==================== MOTORCYCLE MODELS COLLECTION ====================

    match /motorcycle_models/{modelId} {
      // Cashier-facing Job Order picker streams active models — read is not
      // admin-only (mirrors mechanics).
      allow read: if isValidUser() && isActiveUser();

      // Pick-or-add: any active user may create a model inline (like /job_orders).
      allow create: if isValidUser() && isActiveUser() &&
        request.resource.data.createdBy == request.auth.uid;

      // Shared-list grants (2026-07-24): any active user may rename; only
      // staff/admin may flip isActive; delete is staff/admin (2026-07-25).
      allow update: if isValidUser() && isActiveUser() &&
        (isStaffOrAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isActive']));
      // Hard delete (2026-07-25): staff+admin — in-app delete shipped.
      allow delete: if isStaffOrAdmin() && isActiveUser();
    }

    // ==================== VOID REQUESTS COLLECTION ====================

    match /void_requests/{requestId} {
      // Any active valid user can read (pending indicator + admin queue).
      allow read: if isValidUser() && isActiveUser();

      // Requester creates their own pending request.
      allow create: if isValidUser() && isActiveUser() &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Only admin resolves (approve/reject) or marks read. Whoever raised
      // the request cannot decide it — a cashier with an admin login must not
      // void their own sales. A write that leaves status alone (markAllRead's
      // read: true) is unaffected, so the badge batch never trips on the
      // admin's own request.
      allow update: if isAdmin() && isActiveUser() &&
        (request.resource.data.status == resource.data.status ||
         resource.data.requestedBy != request.auth.uid);

      // Audit trail — no deletes.
      allow delete: if false;
    }

    // R2: one pending void request per sale, by construction. One claim doc
    // per sale with an outstanding request, keyed by saleId — its existence
    // IS the lock; the client's create-then-tx.get transaction fails when the
    // doc already exists. Additive only — the void_requests block above is
    // unchanged so +17 clients (which write requests without a claim) keep
    // working; no existsAfter cross-check yet (revisit with the NAME-TOCTOU
    // epic). See docs/superpowers/specs/2026-07-26-race-riders-design.md (R2).
    match /void_request_pending/{saleId} {
      // Any active valid user can read (the tx.get needs it; no secrets here).
      allow read: if isValidUser() && isActiveUser();

      // Requester claims their own sale. A second create on the same saleId
      // fails outright — Firestore create rules only ever apply to a doc
      // that doesn't yet exist.
      allow create: if isValidUser() && isActiveUser() &&
        request.resource.data.requestedBy == request.auth.uid;

      // Only admin frees a claim (resolve path).
      allow delete: if isAdmin() && isActiveUser();

      // Claims are create/delete only — a claim can't be repointed.
      allow update: if false;
    }

    // SKU-uniqueness guard: one claim doc per in-use SKU
    // (key = normalizeSku(sku) = sku.trim().toUpperCase()). Reserved atomically in a
    // transaction by the product create / SKU-rename paths (slices B/C). Slice A only
    // declares the rules + backfills claims; no client enforces it yet.
    match /product_skus/{sku} {
      // The claim transaction's tx.get must succeed for any creator; no secrets here.
      allow read:   if isValidUser() && isActiveUser();
      // MIRROR the products create rule (admin OR staff) — admin-only here would
      // half-commit every staff product create (product written, claim denied).
      allow create: if (isAdmin() || hasRole('staff')) && isActiveUser();
      // Only an admin rename (frees old) or a hard delete frees a claim.
      allow delete: if isAdmin() && isActiveUser();
      // Claims are create/delete only — block update so a claim can't be repointed.
      allow update: if false;
    }

    // Barcode uniqueness claim (Slice A). One product_barcodes/{normalizeBarcode(code)}
    // doc per in-use barcode; enforced in transactions by the product create / barcode
    // edit paths (slices B/C). Slice A only declares the rules + backfills; no client
    // enforces it yet. Policy MIRRORS product_skus.
    match /product_barcodes/{barcode} {
      allow read:   if isValidUser() && isActiveUser();
      // Mirror the products create rule (admin OR staff) so a staff product create
      // doesn't half-commit (product written, claim denied).
      allow create: if (isAdmin() || hasRole('staff')) && isActiveUser();
      // Only an admin rename (frees old) or a hard delete frees a claim.
      allow delete: if isAdmin() && isActiveUser();
      // Claims are create/delete only — block update so a claim can't be repointed.
      allow update: if false;
    }
  }
}
